    {
      "pattern": "^(\\d+)\\s+plugins?$",
      "replace": "$1 پلاگین"
    },
    {
      "pattern": "^(\\d+)\\s+models?$",
      "replace": "$1 مدل"
    },
    {
      "pattern": "^(\\d+)\\s+tools?$",
      "replace": "$1 ابزار"
    },
    {
      "pattern": "^(\\d+)\\s+steps?$",
      "replace": "$1 مرحله"
    },
    {
      "pattern": "^(\\d+)\\s+messages?$",
      "replace": "$1 پیام"
    },
    {
      "pattern": "^(\\d+)\\s+errors?$",
      "replace": "$1 خطا"
    },
    {
      "pattern": "^(\\d+)\\s+warnings?$",
      "replace": "$1 هشدار"
